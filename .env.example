ADMIN_USERNAME=admin
# Generate these locally; use single quotes around the hash to preserve dollar signs.
ADMIN_PASSWORD_HASH='REPLACE_WITH_GENERATED_HASH'
SESSION_SECRET=REPLACE_WITH_GENERATED_SECRET
# false for localhost HTTP only; true behind an HTTPS reverse proxy.
COOKIE_SECURE=false
BIND_ADDRESS=127.0.0.1
PORT=8000
# Set DATA_DIR to an absolute Linux/WSL path before starting Compose.
DATA_DIR=/absolute/path/to/Musicless/data
MODELS_DIR=./models
CONFIG_DIR=./config
MAX_UPLOAD_MB=250
MAX_DURATION_SECONDS=120
MAX_QUEUED_JOBS=3
MAX_OUTSTANDING_PER_USER=1
JOB_TIMEOUT_SECONDS=900
RETENTION_SECONDS=3600
DISK_FLOOR_MB=2048
JOB_STORAGE_MB=1536
ALLOW_CPU=false
WORKER_MEMORY_LIMIT=16g
WORKER_CPUS=4
